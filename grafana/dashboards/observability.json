{
  "uid": "observability-main",
  "title": "System & Application Observability",
  "schemaVersion": 27,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage %",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "legendFormat": "CPU %",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "RAM usage %",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "RAM %",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disk usage % (/)",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"tmpfs\"})",
          "legendFormat": "Disk %",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network throughput",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\"}[1m]))",
          "legendFormat": "Receive",
          "datasource": "Prometheus"
        },
        {
          "refId": "B",
          "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*|br-.*\"}[1m]))",
          "legendFormat": "Transmit",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests per second",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 8,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (rate(orderapi_http_requests_total[1m]))",
          "legendFormat": "{{endpoint}}",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Error rate % (5xx)",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(orderapi_http_requests_total{status=~\"5..\"}[1m])) / sum(rate(orderapi_http_requests_total[1m]))",
          "legendFormat": "Errors %",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p95 request latency",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(orderapi_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Orders created / failed (per minute)",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(orderapi_orders_created_total[1m]))",
          "legendFormat": "Created",
          "datasource": "Prometheus"
        },
        {
          "refId": "B",
          "expr": "sum(increase(orderapi_orders_failed_total[1m]))",
          "legendFormat": "Failed",
          "datasource": "Prometheus"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Host uptime",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_time_seconds - node_boot_time_seconds",
          "legendFormat": "Uptime",
          "datasource": "Prometheus"
        }
      ]
    }
  ]
}